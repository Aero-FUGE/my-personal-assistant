{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "my-personal-assistant-api",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://my-personal-assistant.2563247782.workers.dev",
    "DEEPSEEK_MODEL": "deepseek-flash",
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{
    "binding": "PUSH_DB",
    "database_name": "my-personal-assistant-db",
    "database_id": "3da43036-eabc-4b01-a4f1-979cf49f94a3",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
